# Every variable the compose file beside this one reads.
#
#     cp .env.example .env
#
# Copy it, fill in the credential, and change what a deployment needs to change.
# `.env` is untracked: real values live only on the host they configure. This
# example carries no real ones — placeholder names and RFC 5737 documentation
# addresses only.
#
# The REACHY_GROUNDSTATION_* half is not documentation that has to be kept up to
# date by hand. `test_groundstation_deployment.py` asserts that this file lists
# exactly the settings `reachy_groundstation.config.Settings` declares, and that
# every value below parses to the default that model carries — so a setting
# added, removed or re-defaulted without editing this file is a failing test
# rather than a deployment that quietly disagrees with its own documentation.
# The credential is the one setting with no default, because a groundstation
# that authenticated nothing would be worse than one that refuses to start.
#
# ⚠️ A few settings are listed COMMENTED OUT, and that is deliberate rather than
# an oversight. compose hands this whole file to the container with `env_file`,
# and an `env_file` value overrides the image's own `ENV` — so a line here
# repeating what the image already sets replaces the image's answer with this
# file's. For the accelerated variant that is not harmless: uncommenting the
# provider list below would replace `CUDAExecutionProvider,CPUExecutionProvider`
# with the CPU provider alone, and the image would run on the CPU without saying
# so. Those settings are documented so their existence and their defaults are
# visible, and left unset so the image decides. The same test asserts that the
# commented set is exactly the set the Dockerfile's `ENV` names.

# --- What compose runs ------------------------------------------------------
# These have no REACHY_GROUNDSTATION_ prefix on purpose. The service refuses to
# start on an unrecognised variable under its own prefix, and these are compose's
# rather than the service's.

# Which image to run. The registry path is the repository's own; replace OWNER
# and REPOSITORY with the account and repository the image was published from.
# Append `-cuda` to the tag for the accelerated variant.
GROUNDSTATION_IMAGE=ghcr.io/OWNER/REPOSITORY/groundstation:latest

# Where the session endpoint is published, as `address:port`. The loopback
# interface by default: the session is authenticated but the health, metrics and
# configuration endpoints beside it are not, so exposing the service to a network
# is a deliberate act. `198.51.100.10:8080` would publish it on a particular
# interface.
GROUNDSTATION_PUBLISH=127.0.0.1:8080

# The metrics collector, pinned by digest, and where its own interface is
# published.
PROMETHEUS_IMAGE=prom/prometheus:v3.7.3@sha256:49214755b6153f90a597adcbff0252cc61069f8ab69ce8411285cd4a560e8038
PROMETHEUS_PUBLISH=127.0.0.1:9090

# --- The service's own settings ---------------------------------------------
# One variable per setting, all of them, at the defaults the service carries.

# The shared secret a client presents to open a session. There is no default:
# replace this placeholder with a value generated for this deployment, and keep
# it out of version control.
REACHY_GROUNDSTATION_CREDENTIAL=replace-this-with-a-generated-secret

# The address and port the server binds INSIDE the container. Not what the host
# publishes — that is GROUNDSTATION_PUBLISH above. Set by the image, which binds
# every interface because a container that bound the loopback interface could be
# reached by nothing outside its own network namespace. Changing the port means
# changing `prometheus.yml`'s target too, and a test checks the two agree.
#REACHY_GROUNDSTATION_HOST=0.0.0.0
#REACHY_GROUNDSTATION_PORT=8080

# How many frames one session may hold before the oldest is dropped. Small
# deliberately: a result is useful only while the frame it describes is recent,
# so a deep queue buys latency it cannot spend.
REACHY_GROUNDSTATION_QUEUE_BOUND=2

# How long one capability may spend on one frame before its answer is abandoned.
REACHY_GROUNDSTATION_CAPABILITY_TIMEOUT_SECONDS=5.0

# How long a connected client has to present its offer before the session closes.
REACHY_GROUNDSTATION_HANDSHAKE_TIMEOUT_SECONDS=10.0

# How long one capability may spend warming up before it is recorded unhealthy.
REACHY_GROUNDSTATION_WARM_UP_TIMEOUT_SECONDS=60.0

# The largest message of either kind the session accepts, in bytes.
REACHY_GROUNDSTATION_MAX_MESSAGE_BYTES=4194304

# The lowest severity emitted, and the shape it is emitted in. `json` for a log
# collector, `console` for a terminal.
REACHY_GROUNDSTATION_LOG_LEVEL=info
REACHY_GROUNDSTATION_LOG_FORMAT=json

# What this process calls itself in traces and metrics.
REACHY_GROUNDSTATION_SERVICE_NAME=reachy-groundstation

# Where model files are read from. Set by the image: they are put there when it
# is built and never fetched at run time, so pointing this somewhere else means
# populating that directory correctly yourself and losing the guarantee that the
# service starts on a host with no outbound internet access.
#REACHY_GROUNDSTATION_MODELS_DIR=/opt/reachy/models

# How much of the host the model runtime may take. Left to itself it sizes
# against the host and takes every core it finds; four intra-operator threads is
# where the measured curve flattened — 93 ms at one, 51 ms at four, 55 ms at six.
# One inter-operator thread, because these are single-branch detection graphs
# with almost nothing to overlap.
REACHY_GROUNDSTATION_INFERENCE_INTRA_OP_THREADS=4
REACHY_GROUNDSTATION_INFERENCE_INTER_OP_THREADS=1

# Which execution providers to try, best first, as a comma-separated list.
# Anything this build has not got is skipped and the CPU provider is always the
# last resort. Set by the image, and the one setting where uncommenting this
# would do real damage: the `-cuda` tag ships
# `CUDAExecutionProvider,CPUExecutionProvider`, and replacing that with the line
# below turns the accelerated image into a slower CPU one that reports nothing
# unusual.
#REACHY_GROUNDSTATION_INFERENCE_PROVIDERS=CPUExecutionProvider

# Face detection: whether it is offered, the confidence a detection must reach to
# be reported, and how much two boxes may overlap before the lower-scoring one is
# suppressed.
REACHY_GROUNDSTATION_FACE_ENABLED=true
REACHY_GROUNDSTATION_FACE_SCORE_THRESHOLD=0.6
REACHY_GROUNDSTATION_FACE_NMS_THRESHOLD=0.3

# Gesture recognition. Off, and switching it on offers a capability that answers
# every frame with no gestures: no hand classifier has cleared this repository's
# licence bar, so this build wires no gesture model at all. The thresholds are
# here so the setting exists when one does.
REACHY_GROUNDSTATION_GESTURE_ENABLED=false
REACHY_GROUNDSTATION_GESTURE_SCORE_THRESHOLD=0.6
REACHY_GROUNDSTATION_GESTURE_SAMPLE_INTERVAL=4
